PORT=3000

# Ganti placeholder kredensial, host cluster, dan nama database sesuai data koneksi di MongoDB Atlas Anda.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.<cluster-id>.mongodb.net/<database-name>?retryWrites=true&w=majority&appName=<app-name>

NODE_ENV=development
JWT_SECRET=isi-dengan-secret-kamu-sendiri
JWT_EXPIRES_IN=1d
EXTERNAL_API_KEY=isi-dengan-api-key-kamu-sendiri